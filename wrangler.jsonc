{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eight-sleep-control",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-25",
  "workers_dev": true,
  "vars": { "CONTROL_ENABLED": "true" },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "secrets": { "required": ["TOKEN_KEY"] },
  "durable_objects": {
    "bindings": [{ "name": "SCHEDULER", "class_name": "SchedulerObject" }],
  },
  "previews": {
    "vars": { "CONTROL_ENABLED": "false" },
    "version_metadata": { "binding": "CF_VERSION_METADATA" },
    "durable_objects": {
      "bindings": [{ "name": "SCHEDULER", "class_name": "SchedulerObject" }],
    },
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SchedulerObject"] }],
  "access": {
    "dev": {
      "aud": "local-only-eight-sleep",
      "identity": { "email": "local@example.invalid" },
    },
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.html", "**/*.css", "**/*.txt"], "fallthrough": false },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
